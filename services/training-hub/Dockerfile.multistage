FROM golang:1.23.1-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY pkg ./pkg
COPY services/training-hub ./services/training-hub

RUN CGO_ENABLED=0 GOOS=linux go build -o /out/training-hub ./services/training-hub

FROM alpine:3.20

RUN adduser -D -H appuser
USER appuser

COPY --from=build /out/training-hub /training-hub

EXPOSE 8082

ENTRYPOINT ["/training-hub"]
